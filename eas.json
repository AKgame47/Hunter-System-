{
  "cli": {"version": ">= 16.0.0", "appVersionSource": "local"},
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "android": {
        "image": "latest",
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    }
  }
}
